# Copy this file to .env and fill in the values.
# Lines left blank mean the value is read from your system environment.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=          # your bot token from @BotFather
TELEGRAM_USER_ID=            # your Telegram numeric user ID (required — no default)

# --- Ollama (local LLM) ---
OLLAMA_URL=http://localhost:11434   # base URL of the running Ollama server
OLLAMA_MODEL=qwen3:4b               # model tag to use for classification

# --- Google OAuth ---
GOOGLE_CREDENTIALS_FILE=credentials.json      # path to the file downloaded from Cloud Console
GOOGLE_TOKEN_FILE=token.json                  # where the OAuth token is cached (gitignored)
GOOGLE_TASKS_TOKEN_FILE=tokens/tasks.json     # separate Tasks token; never use Calendar's token
GOOGLE_DRIVE_TOKEN_FILE=tokens/drive.json     # separate Drive token

# --- App ---
TIMEZONE=America/New_York
DB_PATH=noah.db
